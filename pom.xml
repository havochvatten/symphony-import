<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>se.havochvatten.symphonyconfig</groupId>
  <artifactId>symphony-import-tool</artifactId>
  <version>1.1.0</version>
  <packaging>jar</packaging>

  <name>Symphony setup tool</name>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.imageName>symphony-setup-tool</project.imageName>
    <maven.compiler.release>21</maven.compiler.release>
    <version.apache.poi>5.4.1</version.apache.poi>
    <version.commons-cli>1.11.0</version.commons-cli>
    <version.commons-dbcp2>2.12.0</version.commons-dbcp2>
    <version.commons-dbutils>1.8.1</version.commons-dbutils>
    <version.commons-csv>1.11.0</version.commons-csv>
    <version.commons-imaging>1.0.0-alpha6</version.commons-imaging>
    <version.jackson>2.18.2</version.jackson>
    <version.geotools>31.7</version.geotools>
    <version.junit>5.11.0</version.junit>
    <version.system-lambda>1.2.1</version.system-lambda>
    <version.log4j>2.25.3</version.log4j>
    <version.postgresql-jdbc-driver>42.7.7</version.postgresql-jdbc-driver>
    <version.graalvm-buildtools>0.11.4</version.graalvm-buildtools>
    <entryPoint>se.havochvatten.symphonyconfig.SymphonySetupEntry</entryPoint>
  </properties>

  <repositories>
    <repository>
      <id>osgeo</id>
      <name>OSGeo Maven Repository</name>
      <url>https://repo.osgeo.org/repository/geotools-releases</url>
    </repository>
    <repository>
      <id>geo-solutions.it</id>
      <name>GeoSolutions Maven Repository</name>
      <url>https://maven.geo-solutions.it</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>commons-cli</groupId>
      <artifactId>commons-cli</artifactId>
      <version>${version.commons-cli}</version>
    </dependency>
    <dependency>
      <groupId>commons-dbutils</groupId>
      <artifactId>commons-dbutils</artifactId>
      <version>${version.commons-dbutils}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-dbcp2</artifactId>
      <version>${version.commons-dbcp2}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-imaging</artifactId>
      <version>${version.commons-imaging}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi</artifactId>
      <version>${version.apache.poi}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>${version.apache.poi}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-csv</artifactId>
      <version>${version.commons-csv}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${version.jackson}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
      <version>${version.jackson}</version>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>${version.postgresql-jdbc-driver}</version>
    </dependency>
    <dependency>
      <groupId>org.geotools</groupId>
      <artifactId>gt-geopkg</artifactId>
      <version>${version.geotools}</version>
      <exclusions>
        <exclusion>
          <groupId>javax.media</groupId>
          <artifactId>jai_core</artifactId>
        </exclusion>
        <!-- Only GeoPackage features are read; gt-coverage is for raster tiles and brings the JAI stack -->
        <exclusion>
          <groupId>org.geotools</groupId>
          <artifactId>gt-coverage</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.geotools</groupId>
      <artifactId>gt-epsg-hsql</artifactId>
      <version>${version.geotools}</version>
      <exclusions>
        <exclusion>
          <groupId>javax.media</groupId>
          <artifactId>jai_core</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.geotools</groupId>
      <artifactId>gt-geojson</artifactId>
      <version>${version.geotools}</version>
      <exclusions>
        <exclusion>
          <groupId>javax.media</groupId>
          <artifactId>jai_core</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>jakarta.validation</groupId>
      <artifactId>jakarta.validation-api</artifactId>
      <version>3.0.2</version>
    </dependency>
    <dependency>
      <groupId>com.google.code.findbugs</groupId>
      <artifactId>jsr305</artifactId>
      <version>3.0.2</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <version>${version.junit}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>uk.org.webcompere</groupId>
      <artifactId>system-stubs-jupiter</artifactId>
      <version>2.1.8</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.github.stefanbirkner</groupId>
      <artifactId>system-lambda</artifactId>
      <version>${version.system-lambda}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-core</artifactId>
      <version>${version.log4j}</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <!-- GeoTools and the JDBC drivers register themselves through META-INF/services files, which the
           metaInf-services handler merges instead of keeping one copy. The jar goes to target/dist so that
           it does not overwrite the project's own jar. -->
      <plugin>
        <artifactId>maven-assembly-plugin</artifactId>
        <version>3.7.1</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>${entryPoint}</mainClass>
            </manifest>
          </archive>
          <inlineDescriptors>
            <inlineDescriptor>
              <id>jar-with-dependencies</id>
              <formats>
                <format>jar</format>
              </formats>
              <includeBaseDirectory>false</includeBaseDirectory>
              <dependencySets>
                <dependencySet>
                  <outputDirectory>/</outputDirectory>
                  <useProjectArtifact>true</useProjectArtifact>
                  <unpack>true</unpack>
                  <scope>runtime</scope>
                </dependencySet>
              </dependencySets>
              <containerDescriptorHandlers>
                <containerDescriptorHandler>
                  <handlerName>metaInf-services</handlerName>
                </containerDescriptorHandler>
              </containerDescriptorHandlers>
            </inlineDescriptor>
          </inlineDescriptors>
          <appendAssemblyId>false</appendAssemblyId>
          <finalName>dist/${project.build.finalName}</finalName>
          <attach>false</attach>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.graalvm.buildtools</groupId>
        <artifactId>native-maven-plugin</artifactId>
        <version>${version.graalvm-buildtools}</version>
        <extensions>true</extensions>
        <configuration>
          <imageName>${project.imageName}</imageName>
          <mainClass>${entryPoint}</mainClass>
          <buildArgs>
            <buildArg>--no-fallback</buildArg>
            <buildArg>-H:+ReportExceptionStackTraces</buildArg>
            <!-- Only the standard charsets are included by default; POI needs CP1252 for XLSX, and
                 CSV files can be in any charset -->
            <buildArg>-H:+AddAllCharsets</buildArg>
            <!-- Only the build machine's locale is included by default; HSQLDB, which holds GeoTools' EPSG
                 database, formats dates with Locale.UK whatever the locale it runs in -->
            <buildArg>-H:IncludeLocales=en-GB</buildArg>
          </buildArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <artifactId>maven-clean-plugin</artifactId>
        <version>3.1.0</version>
      </plugin>
      <plugin>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.0.2</version>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.3</version>
      </plugin>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.0.2</version>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>graal-metadata</id>
      <build>
        <plugins>
          <!-- The agent is passed to the test JVM directly rather than through native-maven-plugin, which
               adds an access filter of its own that overrides the exclusions in ours. The agent replaces the
               metadata files when the test JVM exits, so metadata for code that is gone is dropped too. -->
          <plugin>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <argLine>-agentlib:native-image-agent=config-output-dir=${project.basedir}/src/main/resources/META-INF/native-image,access-filter-file=${project.basedir}/src/test/resources/graal-agent/access-filter.json,caller-filter-file=${project.basedir}/src/test/resources/graal-agent/caller-filter.json</argLine>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>package-jar</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-assembly-plugin</artifactId>
            <executions>
              <execution>
                <id>assemble</id>
                <phase>package</phase>
                <goals>
                  <goal>single</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>native-win</id>
      <properties>
        <native.classifier>windows-x64</native.classifier>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <configuration>
              <buildArgs combine.children="append">
                <buildArg>--target=windows-amd64</buildArg>
                <buildArg>--no-fallback</buildArg>
                <buildArg>--gc=serial</buildArg>
                <buildArg>-O1</buildArg>
                <buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
                <buildArg>-H:GenerateDebugInfo=0</buildArg>
                <buildArg>-H:+StaticExecutableWithDynamicLibC</buildArg>
              </buildArgs>
            </configuration>
            <executions>
              <execution>
                <id>build-native-win</id>
                <goals>
                  <goal>compile-no-fork</goal>
                </goals>
                <phase>package</phase>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>native-linux</id>
      <properties>
        <native.classifier>linux-x64</native.classifier>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <configuration>
              <buildArgs combine.children="append">
                <buildArg>--target=linux-amd64</buildArg>
                <buildArg>--no-fallback</buildArg>
                <buildArg>--gc=serial</buildArg>
                <buildArg>-O1</buildArg>
                <buildArg>-H:GenerateDebugInfo=0</buildArg>
                <buildArg>-H:+StaticExecutableWithDynamicLibC</buildArg>
              </buildArgs>
            </configuration>
            <executions>
              <execution>
                <id>build-native-linux</id>
                <goals>
                  <goal>compile-no-fork</goal>
                </goals>
                <phase>package</phase>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
